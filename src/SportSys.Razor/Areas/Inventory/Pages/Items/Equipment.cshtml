@page
@model EquipmentModel
@{
    ViewData["Title"] = "Výstroj";
}

@if (Model.StatusMessage is not null)
{
    <div class="infobox">
        <i class="fa-solid fa-circle-check fa-fw"></i> @Model.StatusMessage
    </div>
}

<form method="get" class="filter-form">
    <div class="filter-row">
        <div class="field">
            <label asp-for="Filter.NameFilter"></label>
            <input type="text" asp-for="Filter.NameFilter" class="textbox" placeholder="Název nebo inventární číslo…" />
        </div>
        <div class="field">
            <label asp-for="Filter.CategoryId"></label>
            <select asp-for="Filter.CategoryId" asp-items="Model.CategorySelectList"></select>
        </div>
        <div class="field">
            <label asp-for="Filter.ItemKindId"></label>
            <select asp-for="Filter.ItemKindId" asp-items="Model.ItemKindSelectList"></select>
        </div>
        <div class="field">
            <label asp-for="Filter.StatusFilter"></label>
            <select asp-for="Filter.StatusFilter" asp-items="Model.StatusSelectList"></select>
        </div>
        <div class="field">
            <label class="checkbox-label">
                <input asp-for="Filter.ActiveOnly" type="checkbox" />
                @Html.DisplayNameFor(m => m.Filter.ActiveOnly)
            </label>
        </div>
        <div class="filter-actions">
            <button type="submit" class="button">
                <i class="fa-solid fa-magnifying-glass fa-fw"></i> Hledat
            </button>
            <a class="button secondary" asp-page="Equipment">
                <i class="fa-solid fa-filter-circle-xmark fa-fw"></i> Vymazat filtr
            </a>
        </div>
    </div>
</form>

<p>
    <a class="button" asp-page="Edit" asp-route-itemType="Equipment">
        <i class="fa-solid fa-plus fa-fw"></i> Nová výstroj
    </a>
</p>

@if (Model.Items.Count == 0)
{
    <p class="text-muted">Žádná výstroj nebyla nalezena.</p>
}
else
{
    <table class="grid">
        <thead>
            <tr>
                <th>Inv. číslo</th>
                <th>Název</th>
                <th>Kategorie</th>
                <th>Výrobce</th>
                <th>Druh</th>
                <th>Velikost</th>
                <th>Stav</th>
                <th>Aktivní</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Items)
            {
                <tr>
                    <td><code>@item.InventoryNumber</code></td>
                    <td>@item.Name</td>
                    <td>@item.CategoryName</td>
                    <td>@(item.ManufacturerName ?? "—")</td>
                    <td>@(item.ItemKindName ?? "—")</td>
                    <td>@(item.Size ?? "—")</td>
                    <td>@item.StatusName</td>
                    <td>
                        @if (item.IsActive)
                        {
                            <i class="fa-solid fa-check fa-fw" style="color: var(--color-success-text)"></i>
                        }
                        else
                        {
                            <span class="text-muted">—</span>
                        }
                    </td>
                    <td class="buttons">
                        <a class="button secondary icon-btn" asp-page="Edit" asp-route-id="@item.Id" asp-route-itemType="Equipment"
                           title="Upravit">
                            <i class="fa-solid fa-pen fa-fw"></i>
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
