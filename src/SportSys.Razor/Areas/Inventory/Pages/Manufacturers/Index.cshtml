@page
@model IndexModel
@{
    ViewData["Title"] = "Výrobci";
}

@if (Model.StatusMessage is not null)
{
    <div class="infobox">
        <i class="fa-solid fa-circle-check fa-fw"></i> @Model.StatusMessage
    </div>
}

<form method="get" class="filter-form">
    <div class="filter-row">
        <div class="field">
            <label for="NameFilter">Název</label>
            <input type="text" id="NameFilter" name="NameFilter" class="textbox"
                   value="@Model.NameFilter" placeholder="Hledat podle názvu…" />
        </div>
        <div class="filter-actions">
            <button type="submit" class="button">
                <i class="fa-solid fa-magnifying-glass fa-fw"></i> Hledat
            </button>
            <a class="button secondary" asp-page="Index">
                <i class="fa-solid fa-filter-circle-xmark fa-fw"></i> Vymazat filtr
            </a>
        </div>
    </div>
</form>

<p>
    <a class="button" asp-page="Edit">
        <i class="fa-solid fa-plus fa-fw"></i> Nový výrobce
    </a>
</p>

@if (Model.Manufacturers.Count == 0)
{
    <p class="text-muted">Žádní výrobci nejsou zadáni.</p>
}
else
{
    <table class="grid">
        <thead>
            <tr>
                <th>Název</th>
                <th>Web</th>
                <th>Aktivní</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var m in Model.Manufacturers)
            {
                <tr>
                    <td>@m.Name</td>
                    <td>
                        @if (!string.IsNullOrEmpty(m.Website))
                        {
                            <a href="@m.Website" target="_blank" rel="noopener">@m.Website</a>
                        }
                    </td>
                    <td>
                        @if (m.IsActive)
                        {
                            <i class="fa-solid fa-check fa-fw" style="color: var(--color-success-text)"></i>
                        }
                        else
                        {
                            <span class="text-muted">—</span>
                        }
                    </td>
                    <td class="buttons">
                        <a class="button secondary icon-btn" asp-page="Edit" asp-route-id="@m.Id"
                           title="Upravit">
                            <i class="fa-solid fa-pen fa-fw"></i>
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
