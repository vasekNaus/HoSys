@page
@model IndexModel
@{
    ViewData["Title"] = "Kategorie";
}

@if (Model.StatusMessage is not null)
{
    <div class="infobox">
        <i class="fa-solid fa-circle-check fa-fw"></i> @Model.StatusMessage
    </div>
}

@if (Model.Tree.Count == 0)
{
    <p class="text-muted">
        Žádné kategorie nejsou zadány.
        <a asp-page="Edit"><i class="fa-solid fa-folder-plus fa-fw"></i> Přidat první kategorii</a>
    </p>
}
else
{
    <ul class="category-tree">
        @foreach (var root in Model.Tree)
        {
            await Html.RenderPartialAsync("_CategoryTreeNode", root);
        }
    </ul>
}

@* ── TABULKOVÝ POHLED (zakomentováno – ponecháno pro případné využití) ─────
   Zobrazuje plochý seznam s filtrem. Odkomentovat a nahradit stromový pohled.

<form method="get" class="filter-form">
    <div class="filter-row">
        <div class="field">
            <label for="NameFilter">Název</label>
            <input type="text" id="NameFilter" name="NameFilter" class="textbox"
                   value="@Model.NameFilter" placeholder="Hledat podle názvu…" />
        </div>
        <div class="filter-actions">
            <button type="submit" class="button">
                <i class="fa-solid fa-magnifying-glass fa-fw"></i> Hledat
            </button>
            <a class="button secondary" asp-page="Index">
                <i class="fa-solid fa-filter-circle-xmark fa-fw"></i> Vymazat filtr
            </a>
        </div>
    </div>
</form>

@if (Model.Categories.Count == 0)
{
    <p class="text-muted">Žádné kategorie nejsou zadány.</p>
}
else
{
    <table class="grid">
        <thead>
            <tr>
                <th>Název</th>
                <th>Nadřazená</th>
                <th>Pořadí</th>
                <th>Velikosti</th>
                <th>Aktivní</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var cat in Model.Categories)
            {
                <tr>
                    <td>@cat.Name</td>
                    <td>@(cat.ParentCategoryName ?? "—")</td>
                    <td>@cat.SortOrder</td>
                    <td>
                        @if (cat.HasSizes)
                        {
                            <i class="fa-solid fa-check fa-fw" style="color: var(--color-success-text)" title="Má velikosti"></i>
                        }
                        else
                        {
                            <span class="text-muted">—</span>
                        }
                    </td>
                    <td>
                        @if (cat.IsActive)
                        {
                            <i class="fa-solid fa-check fa-fw" style="color: var(--color-success-text)"></i>
                        }
                        else
                        {
                            <span class="text-muted">—</span>
                        }
                    </td>
                    <td class="buttons">
                        <a class="button secondary" asp-page="Edit" asp-route-id="@cat.Id">
                            <i class="fa-solid fa-pen fa-fw"></i> Upravit
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
*@
