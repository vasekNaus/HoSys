@{
    Layout = "/Pages/Shared/EditorTemplates/_Layout.cshtml";
    var properties = ViewData.ModelMetadata.Properties
        .Where(p => p.ShowForEdit)
        .OrderBy(p => p.Order);
}

@foreach (var property in properties)
{
    if (property.HideSurroundingHtml)
    {
        @Html.Editor(property.PropertyName)
    }
    else if (property.ModelType == typeof(bool))
    {
        <p class="checkbox-field">
            @Html.Editor(property.PropertyName)
            @Html.Label(property.PropertyName)
            @Html.ValidationMessage(property.PropertyName, null, new { @class = "field-validation-error" })
        </p>
    }
    else
    {
        <p>
            @Html.Label(property.PropertyName)
            @if (!string.IsNullOrWhiteSpace(property.Description))
            {
                <span class="description">@property.Description</span>
            }
            @Html.Editor(property.PropertyName)
            @Html.ValidationMessage(property.PropertyName, null, new { @class = "field-validation-error" })
        </p>
    }
}
